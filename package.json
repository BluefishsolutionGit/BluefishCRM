{
  "name": "bluefish-crm",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:web": "npm --workspace @bluefish/web run dev",
    "dev:api": "npm --workspace @bluefish/api run start:dev",
    "build": "npm run build --workspace @bluefish/shared && npm run build --workspace @bluefish/web && npm run build --workspace @bluefish/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace @bluefish/api run db:migrate",
    "db:seed": "npm --workspace @bluefish/api run db:seed",
    "test": "npm --workspace @bluefish/api run test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "vitest": "^4.1.10"
  }
}
