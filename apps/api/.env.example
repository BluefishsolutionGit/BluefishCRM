DATABASE_URL="postgresql://bluefish:bluefish@localhost:5439/bluefish_crm?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=4000
WEB_BASE_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="http://localhost:4000/api/auth/sso/microsoft/callback"
MICROSOFT_ALLOWED_DOMAINS="bluefishsolution.com"

# Calendar sync (Settings → Integrations → Calendar sync). Separate redirect URI from
# the login SSO flow above since the scopes differ (Calendars.ReadWrite vs. User.Read).
MICROSOFT_CALENDAR_REDIRECT_URI="http://localhost:4000/api/integrations/calendar/microsoft/callback"
# Public HTTPS URL Microsoft Graph can POST change notifications to. Leave blank in dev —
# calendar sync falls back to the 5-minute polling cron when this isn't set.
MICROSOFT_WEBHOOK_URL=""

# Encryption key for stored integration credentials (channel configs, calendar OAuth
# tokens) — base64 32 bytes, or any string (SHA-256'd to 32 bytes). Leave blank in dev
# to use a deterministic fallback key; MUST be set in production.
INTEGRATION_ENC_KEY=""

# Anthropic API (leave blank in dev to use the deterministic fallback)
ANTHROPIC_API_KEY=""
AI_DEFAULT_MODEL="claude-haiku-4-5-20251001"

LINE_CHANNEL_SECRET=""
META_APP_SECRET=""
FB_VERIFY_TOKEN="bluefish-fb-verify"

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# FlowAccount (Thai accounting SaaS) — https://developers.flowaccount.com/
# Leave client id/secret blank in dev to use the deterministic stub.
# Request access at https://form.flowaccount.com/request-openapi
FLOWACCOUNT_MODE=""                                        # auto | stub | live
FLOWACCOUNT_BASE_URL="https://openapi.flowaccount.com/sandbox"
FLOWACCOUNT_TOKEN_URL="https://openapi.flowaccount.com/v1/token"
FLOWACCOUNT_CLIENT_ID=""
FLOWACCOUNT_CLIENT_SECRET=""
FLOWACCOUNT_CULTURE="th"
