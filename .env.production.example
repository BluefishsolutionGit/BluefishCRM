# ────────────────────────────────────────────────────────────────────
# Bluefish CRM — production env template
# Copy to `.env` on the host, fill in the ??? values, then keep it out
# of git. Every value is either REQUIRED or explicitly labelled optional.
# ────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ─────────────────────────────────────────────
# Change the password before first `docker compose up`. The api service
# assembles DATABASE_URL from these — don't set it directly.
POSTGRES_USER=bluefish
POSTGRES_PASSWORD=???change-me???
POSTGRES_DB=bluefish_crm

# ── Auth secrets (REQUIRED) ─────────────────────────────────────────
# Both must be 32+ random bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=???
REFRESH_TOKEN_SECRET=???
# JWT lifetime in seconds — 900 = 15 minutes.
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=14

# ── Web ↔ API allowlists (REQUIRED) ─────────────────────────────────
# Public domain of the SPA. Comma-separated for multi-origin.
CORS_ORIGINS=https://crm.bluefishsolution.tech

# Public URL of the API — shown in Settings › Inbox channels so ops can
# copy the exact webhook URL into each vendor console. Same origin as
# the SPA when Caddy fronts both.
PUBLIC_API_URL=https://crm.bluefishsolution.tech/api

# ── Integrations encryption (STRONGLY RECOMMENDED) ─────────────────
# AES-256-GCM key for Inbox channel secrets at rest. Missing = the app
# uses a dev fallback and logs a warning. Generate with:
#   openssl rand -base64 32
INTEGRATION_ENC_KEY=???

# ── AI (OPTIONAL) ───────────────────────────────────────────────────
# When ANTHROPIC_API_KEY is unset, every AI feature (agents + scan-card
# vision) transparently falls back to deterministic mocks.
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-haiku-4-5-20251001
AI_VISION_MODEL=claude-haiku-4-5-20251001

# ── Web-push (OPTIONAL — mobile browser notifications) ─────────────
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bluefishsolution.com

# ── WebAuthn (OPTIONAL — Face/Touch ID login) ──────────────────────
WEBAUTHN_RP_ID=crm.bluefishsolution.tech
WEBAUTHN_ORIGIN=https://crm.bluefishsolution.tech

# ── Microsoft 365 calendar (OPTIONAL) ──────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALENDAR_REDIRECT_URI=https://crm.bluefishsolution.tech/api/integrations/calendar/microsoft/callback
# Only if you have a public HTTPS URL for Graph webhooks; else the 5-min
# polling cron handles it.
MICROSOFT_WEBHOOK_URL=

# ── Inbox channel env fallbacks (OPTIONAL) ─────────────────────────
# Only used if a channel is NOT configured via Settings › Inbox channels.
# Prefer the UI — env values here are legacy fallbacks.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
META_APP_SECRET=
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
INBOX_WEBSITE_KEY=

# ── Runtime knobs (OPTIONAL) ───────────────────────────────────────
NODE_ENV=production
# Per-IP throttle caps — leave as-is unless you have a specific reason.
THROTTLE_DEFAULT_LIMIT=1000
THROTTLE_AUTH_LIMIT=20

# ── Build-time (used by docker compose build for web) ──────────────
# Baked into the SPA bundle. Use /api for same-origin (Caddy front),
# or an absolute URL for split-domain deployments.
VITE_API_BASE=/api
